# Puerto en el que escucha la API (Render lo asigna automáticamente en la nube)
PORT=5000

# Cadena de conexión a MongoDB Atlas.
# Reemplaza <usuario>, <password> y <cluster> con los datos de tu clúster.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/melodia_store?retryWrites=true&w=majority

# Clave secreta para firmar los JWT (usa una cadena larga y aleatoria; nunca la subas al repositorio).
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<clave_secreta_larga_y_aleatoria>

# Tiempo de vida del token
JWT_EXPIRES_IN=5m
